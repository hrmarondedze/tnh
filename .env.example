# GEMINI_API_KEY: Required if optional server-side AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by AI Studio Cloud SQL Proxy)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Cloud SQL Admin Variables for Drizzle Kit Schema Migrations
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"
